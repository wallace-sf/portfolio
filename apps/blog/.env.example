# Blog app environment variables
#
# Do NOT add real credentials here — this file is committed to git.
#
# Copy to apps/blog/.env.local and fill in your values for local development.
# In production, set these variables through your hosting platform (e.g. Vercel).

# Canonical public origin (same domain as apps/site). Optional locally.
NEXT_PUBLIC_SITE_URL="http://localhost:3002"

# GA4 Measurement ID, shared with apps/site. Optional — analytics is skipped when unset.
NEXT_PUBLIC_GA_MEASUREMENT_ID=""

# Portfolio links surfaced in the blog side navigation. Shared with apps/site.
NEXT_PUBLIC_GITHUB_URL="https://github.com/your-username"
NEXT_PUBLIC_LINKEDIN_URL="https://www.linkedin.com/in/your-username"
NEXT_PUBLIC_RESUME_URL_EN_US="https://example.com/resume-en.pdf"
NEXT_PUBLIC_RESUME_URL_PT_BR="https://example.com/resume-pt.pdf"
NEXT_PUBLIC_RESUME_URL_ES="https://example.com/resume-es.pdf"
#
# apps/site reads BLOG_APP_URL to rewrite /blog/* to this app's deployment
# (Vercel multi-zone) — that variable lives in apps/site/.env.example, not
# here, since it's consumed by apps/site.
