{
  "extends": "@repo/typescript-config/react.json",
  "compilerOptions": {
    "baseUrl": "src",
    "paths": {
      "~/*": ["*"]
    }
  },
  "references": [
    { "path": "../../packages/core/tsconfig.build.json" },
    { "path": "../../packages/ui/tsconfig.build.json" }
  ],
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "tailwind.config.ts",
    "vitest.config.ts",
    "test/**/*.ts",
    "test/**/*.tsx"
  ],
  "exclude": ["node_modules", "dist", "build"]
}
