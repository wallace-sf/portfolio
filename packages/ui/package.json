{
  "name": "@repo/ui",
  "version": "0.0.0",
  "sideEffects": [
    "*.css"
  ],
  "private": true,
  "exports": {
    "./globals.css": "./globals.css",
    "./Control": {
      "types": "./dist/types/Control/index.d.ts",
      "import": "./dist/Control/index.mjs",
      "require": "./dist/Control/index.js"
    },
    "./Control/Button/Link": {
      "types": "./dist/Control/Button/Link/index.d.ts",
      "import": "./dist/Control/Button/Link/index.mjs",
      "require": "./dist/Control/Button/Link/index.js"
    },
    "./Imagery": {
      "types": "./dist/types/Imagery/index.d.ts",
      "import": "./dist/Imagery/index.mjs",
      "require": "./dist/Imagery/index.js"
    },
    "./View": {
      "types": "./dist/types/View/index.d.ts",
      "import": "./dist/View/index.mjs",
      "require": "./dist/View/index.js"
    },
    "./View/MermaidBlock": {
      "types": "./dist/types/View/Markdown/MermaidBlock.d.ts",
      "import": "./dist/View/MermaidBlock/index.mjs",
      "require": "./dist/View/MermaidBlock/index.js"
    }
  },
  "os": [
    "linux"
  ],
  "files": [
    "dist/",
    "globals.css",
    "markdown-headings.css",
    "markdown-theme.css"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint --fix --ext .ts,.tsx src",
    "lint:check": "eslint --ext .ts,.tsx src",
    "format": "prettier --write 'src/**/*.{ts,tsx}'",
    "format:check": "prettier --check 'src/**/*.{ts,tsx}'",
    "build:types": "tsc --build tsconfig.build.json",
    "types": "tsc --build tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "generate:markdown-theme": "node scripts/generate-markdown-theme.mts"
  },
  "peerDependencies": {
    "react": "^18",
    "react-dom": "^18"
  },
  "dependencies": {
    "@iconify/react": "^5.0.2",
    "@repo/utils": "workspace:*",
    "@shikijs/transformers": "~1.29.2",
    "classnames": "^2.5.1",
    "github-markdown-css": "^5.9.0",
    "hast-util-to-jsx-runtime": "^2.3.6",
    "react-tooltip": "^5.28.0",
    "rehype-pretty-code": "^0.14.1",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.0",
    "remark-mark-highlight": "^0.1.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "shiki": "^1.29.2",
    "tiny-invariant": "^1.3.3",
    "unified": "^11.0.5",
    "usehooks-ts": "^3.1.1"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/prettier-config": "workspace:*",
    "@repo/tailwind-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/hast": "^3.0.4",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.0.0",
    "@vitest/coverage-v8": "^3.0.0",
    "autoprefixer": "^10.4.20",
    "jsdom": "^25.0.0",
    "postcss": "^8",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwindcss": "^3.4.1",
    "tsup": "^8.3.5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^3.0.0"
  }
}
